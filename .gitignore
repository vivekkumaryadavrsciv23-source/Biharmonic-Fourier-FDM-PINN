# ── Jupyter ──────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Python cache ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Model weights (large binary files) ───────────────
*.pt
*.pth
*.ckpt

# ── Large data files (regeneratable) ─────────────────
field_data.csv
training_convergence.csv

# ── Images / Figures (generated by scripts) ──────────
figures/
figures-old/
*.png
*.jpg
*.jpeg
*.svg
*.eps
*.pdf

# ── LaTeX build artifacts ─────────────────────────────
*.aux
*.log
*.out
*.spl
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk

# ── OS junk ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Outputs folders (figures inside results) ──────────
**/results/*/figures/
**/outputs/
